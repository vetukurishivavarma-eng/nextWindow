# Copy to .env and adjust. Never commit .env.

# Public URL users open (used for notification links and CORS)
PUBLIC_URL=http://localhost:8081
APP_PORT=8081

# Database
DATABASE_PASSWORD=change-me

# Set to true when served over HTTPS
COOKIE_SECURE=false

# Browser push (optional). Generate with: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Development demo sources and seeded demo account. Set both to false in production.
DEMO_ENABLED=true
DEMO_SEED_USER=true
